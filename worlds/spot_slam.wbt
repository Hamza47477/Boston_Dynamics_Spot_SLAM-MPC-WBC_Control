WorldInfo {
  basicTimeStep 8
  info [
    "Mapping world for stereo SLAM: textured arena, two partition walls, props,"
    "parked and moving cars, walking and standing pedestrians."
  ]
  title "Spot SLAM world"
}
Viewpoint {
  orientation 0.25 0.1 -0.96 0.9
  position -9.5 -9.0 6.5
}
TexturedBackground {
  texture "factory"
  skybox FALSE
}
TexturedBackgroundLight {
  texture "factory"
}
# ---- floor and four distinct walls (20 x 20 m)
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [ "@TEX@/floor.png" ]
        }
        roughness 1
        metalness 0
        textureTransform TextureTransform {
          scale 5 5
        }
      }
      geometry Box {
        size 20.4 20.4 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 20.4 20.4 0.1
  }
}
Solid {
  translation 0 10.1 1.7
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
