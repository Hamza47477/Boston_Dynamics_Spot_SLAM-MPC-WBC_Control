# ---- cars (kinematic models: the plugin moves CAR_MOVING)
DEF CAR_PARKED_1 TeslaModel3Simple {
  translation 5.0 -7.0 0.4
  rotation 0 0 1 0.15
  color 0.75 0.1 0.1
  name "car parked 1"
}
DEF CAR_PARKED_2 CitroenCZeroSimple {
  translation -6.0 6.0 0.4
  rotation 0 0 1 1.0
  color 0.1 0.25 0.7
  name "car parked 2"
}
DEF CAR_MOVING TeslaModel3Simple {
  translation 8.0 -8.0 0.4
  rotation 0 0 1 1.5708
  color 0.85 0.85 0.85
  name "car moving"
}

# ---- people
DEF PED_1 Pedestrian {
  translation -5.0 -4.0 1.27
  name "pedestrian 1"
  shirtColor 0.8 0.2 0.2
  controllerArgs [
    "--trajectory=-5 -4, -5 3"
    "--speed=0.9"
  ]
}
DEF PED_2 Pedestrian {
  translation 0.5 0.5 1.27
  name "pedestrian 2"
  shirtColor 0.2 0.3 0.8
  controllerArgs [
    "--trajectory=0.5 0.5, 7 0.5, 7 -4, 0.5 -4"
    "--speed=1.0"
  ]
}
DEF PED_3 Pedestrian {
  translation 4.0 5.0 1.27
  rotation 0 0 1 2.4
  name "pedestrian 3"
  shirtColor 0.2 0.6 0.3
}

# ---- Spot with a rectified stereo pair (12 cm baseline) and a hidden depth sensor
# The extension frame is rotated; the Pose below undoes that so that children use the
# body frame (x forward, y left, z up). All three sensors look straight ahead.
Spot {
  translation -7 -6.5 0.624
  rotation 0 0 1 0.5
  name "Spot"
  controller "<extern>"
  supervisor TRUE
  frontExtension [
    Pose {
      rotation 0.577350 -0.577354 -0.577346 -2.094389
      children [
        Camera {
          translation 0.30 0.06 0.08
          name "stereo_left"
          width 512
          height 288
          fieldOfView 1.396
          near 0.1
        }
        Camera {
          translation 0.30 -0.06 0.08
          name "stereo_right"
          width 512
          height 288
          fieldOfView 1.396
          near 0.1
        }
        RangeFinder {
          translation 0.30 0.06 0.08
          name "stereo_depth_gt"
          width 512
          height 288
          fieldOfView 1.396
          minRange 0.1
          maxRange 20
        }
      ]
    }
  ]
}
